# =============================================================================
# PR•VISION — AI Early-Warning System for Misinformation Spread
# Environment configuration template
# Copy to .env and fill in real values. NEVER commit real secrets.
# =============================================================================

APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (MySQL is the primary supported engine; SQLite is a dev/demo fallback)
# -----------------------------------------------------------------------------
DB_ENGINE=mysql                # mysql | sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=prvision
MYSQL_USER=prvision
MYSQL_PASSWORD=change-me
# Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
# Only used when DB_ENGINE=sqlite (local demos / CI without a MySQL server)
SQLITE_PATH=ml/datasets/prvision_demo.db

# -----------------------------------------------------------------------------
# Application / API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins. "*" allows all (dev only).
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Frontend auto-refresh (seconds) and ingestion defaults
# ----------------------------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=8
INGESTION_INTERVAL_SECONDS=30
INGESTION_ENABLED_ON_STARTUP=false
# Platforms the scheduler loops at startup. The big-5 run as keyless
# web-search harvesters unless official credentials exist (see docs/api-integrations.md);
# mastodon/hackernews run on free public APIs with real engagement metrics.
INGESTION_STARTUP_PLATFORMS=demo,x,reddit,instagram,facebook,linkedin,mastodon,hackernews
# Harvest tuning (big-5 web-search pipeline)
HARVEST_DISCOVERY_INTERVAL_SECONDS=900
HARVEST_POSTS_PER_DISCOVERY=12
HARVEST_SEARCH_NUM=8
HARVEST_RECENCY_DAYS=7
# Public-API platforms
MASTODON_INSTANCES=mastodon.world,techhub.social,universeodon.com
HACKERNEWS_ENABLED=true

# =============================================================================
# >>> PUBLIC DEPLOYMENT: see DEPLOYMENT.md for step-by-step hosting guides
#     (Railway / Render / Fly.io / VPS with docker compose). <<<
# =============================================================================

# -----------------------------------------------------------------------------
# ML configuration
# -----------------------------------------------------------------------------
ML_MODELS_DIR=ml/models
FORECAST_HORIZONS=30,60,120
PREDICTION_MIN_HISTORY_SNAPSHOTS=3
# Intervention priority weights (must sum to 1.0)
WEIGHT_SPREAD_RISK=0.60
WEIGHT_MISINFORMATION_RISK=0.40

# -----------------------------------------------------------------------------
# Platform API credentials (all optional — leave empty to run in demo mode)
# Official APIs only. The system never fabricates metrics a platform
# does not expose; unavailable fields are stored as NULL.
# -----------------------------------------------------------------------------

# X (Twitter) API v2 — https://developer.x.com
X_BEARER_TOKEN=

# Reddit API (OAuth2, script app) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=prvision-early-warning/1.0 (by /u/your-user)

# Meta Graph API (Instagram / Facebook) — https://developers.facebook.com
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ID=

# LinkedIn Marketing/Community API — https://developer.linkedin.com
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# -----------------------------------------------------------------------------
# VERIFICATION ENGINE — multimodal evidence providers (spec #5-#8, #26, #27)
# Keys NEVER live in frontend JavaScript. Empty values => the provider reports
# DISABLED and is skipped honestly (nothing is fabricated).
# -----------------------------------------------------------------------------

# Provider sidecar: local Node bridge (sidecar/server.mjs) exposing web search,
# page reader, LLM claim refinement and vision analysis.
SIDECAR_ENABLED=true
SIDECAR_URL=http://127.0.0.1:8787
SIDECAR_TIMEOUT_SECONDS=55
# true  -> container entrypoint auto-starts the sidecar embedded in the image
# false -> sidecar runs as its own container (docker-compose.yml) — point
#          SIDECAR_URL at it (http://sidecar:8787)
SIDECAR_EMBEDDED=true

# z-ai SDK credentials for EXTERNAL hosts (the sandbox injects them
# automatically). Value = full JSON of the .z-ai-config file:
#   ZAI_CONFIG_JSON={"apiKey":"...","baseUrl":"https://api.example.com/v1"}
# Without it the sidecar runs degraded and the system honestly disables
# web-harvest + LLM/vision evidence (nothing is fabricated).
ZAI_CONFIG_JSON=

# Google Fact Check Tools API — https://developers.google.com/fact-check
GOOGLE_FACTCHECK_API_KEY=

# NewsAPI — https://newsapi.org (optional extra news evidence provider)
NEWSAPI_KEY=

# URL fetching guardrails
VERIFY_FETCH_TIMEOUT_SECONDS=20
VERIFY_FETCH_MAX_BYTES=5000000
VERIFY_MAX_CLAIMS=12
VERIFY_MAX_EVIDENCE_PER_CLAIM=6

# Upload handling (PDF/DOCX/CSV/images)
VERIFY_UPLOAD_DIR=ml/uploads
VERIFY_UPLOAD_MAX_MB=25

# =============================================================================
# SECURITY / AUTH (production upgrade)
# =============================================================================
# Any random 64-char string. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Session lifetime and password policy
AUTH_TOKEN_EXPIRE_HOURS=72
MIN_PASSWORD_LENGTH=8
# Seed the documented demo analyst (demo@prvision.ai / DemoVision!2026) on first run.
# Set false for real deployments and create your own admin (first registered account becomes admin).
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@prvision.ai
DEMO_USER_PASSWORD=DemoVision!2026

# Rate limiting (per IP, per process; sliding window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_VERIFY_PER_MINUTE=12
RATE_LIMIT_EXPORT_PER_MINUTE=30
